<Window
    x:Class="Signal.Native.Uno.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Signal.Native.Uno.App"
    xmlns:roll="using:Signal.Native.Uno.App.PianoRoll">
    <Grid x:Name="WorkspaceRoot" PreviewKeyDown="TransportKeyDown" PreviewKeyUp="TransportKeyUp"
          SizeChanged="WorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="MainMenu" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="File" Style="{StaticResource SubtleButtonStyle}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="NewSongMenuItem" Text="New" Click="NewSongClicked">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="OpenSongButton" Text="Open MIDI…" Click="OpenSongClicked">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SaveSongButton" Text="Save" Click="SaveSongClicked">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveSongAsButton" Text="Save as…" Click="SaveSongAsClicked">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem Text="Export">
                            <MenuFlyoutItem x:Name="ExportOggMenuItem" Text="Ogg…" Click="ExportOggClicked" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Content="Song" Style="{StaticResource SubtleButtonStyle}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="CropSongMenuItem" Text="Crop song…" Click="CropSongClicked" />
                        <MenuFlyoutItem x:Name="UndoCropMenuItem" Text="Undo crop…" Click="UndoCropClicked" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Content="View" Style="{StaticResource SubtleButtonStyle}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="MIDI monitor…" Click="OpenMidiMonitorClicked" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Content="Settings" Style="{StaticResource SubtleButtonStyle}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Audio &amp; MIDI…" Click="AudioMidiSettingsClicked" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
        <Grid Grid.Row="1" Padding="20,16,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TempoChangesButton" Content="Tempo changes…" Click="TempoChangesClicked"
                        ToolTipService.ToolTip="Edit the song's tempo changes" />
                <TextBlock x:Name="SongNameText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
            <InfoBar x:Name="FileErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" />
            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="JumpToStartButton" Click="JumpToStartClicked"
                            AutomationProperties.Name="Jump to song start"
                            ToolTipService.ToolTip="Jump to song start (Home)">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <Button x:Name="PlayButton" Click="PlayClicked" IsEnabled="False" MinWidth="112"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Play song"
                            ToolTipService.ToolTip="Play all tracks">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                            <TextBlock x:Name="PlayLabel" Text="Play song" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="StopClicked" IsEnabled="False"
                            AutomationProperties.Name="Stop"
                            ToolTipService.ToolTip="Stop and return to bar 1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Stop" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SongRecordButton" Content="Record" Click="SongRecordClicked"
                            IsEnabled="False" ToolTipService.ToolTip="Record into the selected track. Turn on Loop to overdub." />
                    <CheckBox x:Name="CountInBox" Content="Count-in" MinWidth="0"
                              ToolTipService.ToolTip="Play one measure of clicks before recording" />
                    <ToggleButton x:Name="LoopButton" Content="Loop" Click="LoopClicked"
                                  AutomationProperties.Name="Loop playback"
                                  ToolTipService.ToolTip="Repeat the highlighted range or the whole song" />
                    <ToggleButton x:Name="SongMetronomeButton" Content="Metronome"
                                  Click="SongMetronomeClicked" IsEnabled="False"
                                  ToolTipService.ToolTip="Click during song playback or recording" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="LoopRangeText" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="PlaybackStatusText" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button x:Name="ClearLoopRangeButton" Grid.Column="1" Content="Clear range"
                            Click="ClearLoopRangeClicked" Visibility="Collapsed"
                            ToolTipService.ToolTip="Use the whole song for looping" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="SongTempoText" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button x:Name="MeterButton" Click="MeterClicked" ToolTipService.ToolTip="Edit time signatures"
                            Padding="10,4" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tracks" VerticalAlignment="Center"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button x:Name="UndoTrackButton" Grid.Column="1" Content="Undo track edit"
                                    Click="UndoTrackClicked" IsEnabled="False" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="AddInstrumentButton" Content="Add instrument"
                                    AutomationProperties.Name="Add instrument track" Click="AddInstrumentClicked" />
                            <Button x:Name="AddDrumButton" Content="Add drums"
                                    AutomationProperties.Name="Add drum track" Click="AddDrumClicked" />
                        </StackPanel>
                        <ListView x:Name="TrackList" Grid.Row="2" SelectionMode="Single"
                                  SelectionChanged="TrackChanged" AutomationProperties.Name="Song tracks">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"
                                                 Color="{ThemeResource TextFillColorPrimary}" Opacity="0.09" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                                 Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                                 Color="{ThemeResource SystemAccentColor}" Opacity="0.38" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                                 Color="{ThemeResource SystemAccentColor}" Opacity="0.33" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemExpanded}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackRow">
                                    <Grid ColumnSpacing="6" Margin="2,5" Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Duplicate track" Tag="{x:Bind Track}"
                                                                IsEnabled="{x:Bind CanMix, Mode=OneWay}" Click="DuplicateTrackClicked" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <ToggleButton Content="M" Padding="6,3" Tag="{x:Bind Track}" Click="MuteTrackClicked"
                                                          IsChecked="{x:Bind IsMuted, Mode=OneWay}" IsEnabled="{x:Bind CanMix, Mode=OneWay}"
                                                          AutomationProperties.Name="{x:Bind MuteLabel}" ToolTipService.ToolTip="Mute track" />
                                            <ToggleButton Content="S" Padding="6,3" Tag="{x:Bind Track}" Click="SoloTrackClicked"
                                                          IsChecked="{x:Bind IsSoloed, Mode=OneWay}" IsEnabled="{x:Bind CanMix, Mode=OneWay}"
                                                          AutomationProperties.Name="{x:Bind SoloLabel}" ToolTipService.ToolTip="Solo track" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock x:Name="TrackChannelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="TrackSoundBox" Header="Sound" HorizontalAlignment="Stretch"
                                      SelectionChanged="TrackSoundChanged" />
                            <ComboBox x:Name="MidiRoutingBox" Header="MIDI input routing" SelectedIndex="0"
                                      HorizontalAlignment="Stretch" SelectionChanged="MidiRoutingChanged"
                                      ToolTipService.ToolTip="Selected track plays the highlighted track. Multi matches the incoming MIDI channel.">
                                <ComboBoxItem Content="Selected track" />
                                <ComboBoxItem Content="Multi" />
                            </ComboBox>
                            <TextBlock x:Name="TrackChannelHint" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="TrackControlsButton" Content="Channel controls…" HorizontalAlignment="Stretch">
                                <Button.Flyout>
                                    <Flyout x:Name="ChannelControlsFlyout" Placement="Right">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBox x:Name="ChannelVolumeBox" Header="Opening volume" Width="132"
                                                         InputScope="Number" LostFocus="ChannelControlLostFocus" KeyDown="ChannelControlKeyDown" />
                                                <Button Content="Show lane" VerticalAlignment="Bottom" Click="ShowVolumeLaneClicked"
                                                        AutomationProperties.Name="Show volume lane" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBox x:Name="ChannelPanBox" Header="Opening pan" Width="132"
                                                         InputScope="Number" LostFocus="ChannelControlLostFocus" KeyDown="ChannelControlKeyDown"
                                                         ToolTipService.ToolTip="Negative is left, 0 is center, positive is right" />
                                                <Button Content="Show lane" VerticalAlignment="Bottom" Click="ShowPanLaneClicked"
                                                        AutomationProperties.Name="Show pan lane" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="RenameTrackButton" Content="Rename…" Click="RenameTrackClicked" />
                                <Button x:Name="RemoveTrackButton" Content="Remove track" Click="RemoveTrackClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <roll:PianoRollView x:Name="RollView" Grid.Column="1" />
            </Grid>
        </Grid>
        <ContentDialog x:Name="AudioMidiSettingsDialog" Title="Audio &amp; MIDI" CloseButtonText="Close">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer x:Name="AudioMidiSettingsScroll" HorizontalContentAlignment="Stretch"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="0,2,8,0" Spacing="18"
                            PreviewKeyDown="CalibrationKeyDown" PreviewKeyUp="CalibrationKeyUp">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="AudioDeviceBox" Header="Audio output"
                                          HorizontalAlignment="Stretch" SelectionChanged="AudioSettingsChanged" />
                                <ComboBox x:Name="MidiDeviceBox" Grid.Column="1" Header="MIDI input"
                                          HorizontalAlignment="Stretch" SelectionChanged="MidiInputChanged" />
                                <ComboBox x:Name="PeriodBox" Grid.Row="1" Header="Audio period" SelectedIndex="0"
                                          HorizontalAlignment="Stretch" SelectionChanged="AudioSettingsChanged">
                                    <ComboBoxItem Content="Minimum" />
                                    <ComboBoxItem Content="Conservative" />
                                    <ComboBoxItem Content="Default" />
                                </ComboBox>
                                <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="1" Content="Refresh devices"
                                        VerticalAlignment="Bottom" Click="RefreshDevicesClicked" />
                            </Grid>
                            <TextBlock x:Name="AudioFormatText" Text="Starting audio…" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Grid x:Name="DiagnosticsGrid" ColumnSpacing="8" RowSpacing="2">
                                <Grid.Resources>
                                    <Style x:Key="CounterLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                    <Style x:Key="CounterValue" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Render passes" Style="{StaticResource CounterLabel}" />
                                <TextBlock x:Name="RenderPassesValue" Grid.Row="1" Text="—" Style="{StaticResource CounterValue}" />
                                <TextBlock Text="Estimated underruns" Grid.Column="1" Style="{StaticResource CounterLabel}" />
                                <TextBlock x:Name="UnderrunsValue" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource CounterValue}" />
                                <TextBlock Text="Clock failures" Grid.Column="2" Style="{StaticResource CounterLabel}" />
                                <TextBlock x:Name="ClockFailuresValue" Grid.Row="1" Grid.Column="2" Text="—" Style="{StaticResource CounterValue}" />
                                <TextBlock Text="MIDI drops" Grid.Column="3" Style="{StaticResource CounterLabel}" />
                                <TextBlock x:Name="MidiDropsValue" Grid.Row="1" Grid.Column="3" Text="—" Style="{StaticResource CounterValue}" />
                                <TextBlock Text="Capture drops" Grid.Column="4" Style="{StaticResource CounterLabel}" />
                                <TextBlock x:Name="CaptureDropsValue" Grid.Row="1" Grid.Column="4" Text="—" Style="{StaticResource CounterValue}" />
                            </Grid>
                            <TextBlock x:Name="MidiErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="PreferenceErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SoundFontButton" Content="Load SoundFont…" Click="LoadSoundFontClicked" />
                        <TextBlock x:Name="SoundFontText" Grid.Column="1" Text="Loading SoundFont…"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="TestNoteButton" Grid.Column="2" Content="Play test note"
                                IsEnabled="False" Click="TestNoteClicked" />
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Recording offset calibration" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Tap once per click to estimate an offset for your input. The instrument is muted and the first two taps are practice."
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="CalibrationInputBox" SelectedIndex="1" MinWidth="145"
                                          AutomationProperties.Name="Tap input" SelectionChanged="CalibrationInputChanged">
                                    <ComboBoxItem Content="MIDI keyboard" />
                                    <ComboBoxItem Content="Space key" />
                                </ComboBox>
                                <Button x:Name="CalibrationButton" Content="Start tap test" IsEnabled="False"
                                        Click="CalibrationClicked" />
                                <Button x:Name="ApplyCalibrationButton" Content="Apply offset" IsEnabled="False"
                                        Click="ApplyCalibrationClicked" />
                            </StackPanel>
                            <TextBlock x:Name="CalibrationStatusText" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Recording test" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Play with your instrument sound to check note placement and monitoring delay. For an offset suggestion, play one note per click for at least six clicks."
                                       TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="TestMetronomeBox" Content="Metronome during test · 120 BPM"
                                          IsChecked="True" IsEnabled="False" VerticalAlignment="Bottom" />
                                <NumberBox x:Name="OffsetBox" Grid.Column="1" Header="Recording offset (ms)"
                                           Value="10" Minimum="-500" Maximum="500" SmallChange="1"
                                           ValueChanged="RecordingOffsetChanged"
                                           SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="Positive values place recorded notes earlier." />
                                <ComboBox x:Name="QuantizeBox" Grid.Column="2" Header="Quantize"
                                          MinWidth="92" VerticalAlignment="Top" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="RecordButton" Content="Record test" Click="RecordClicked" IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ShowTakeButton" Content="Show in piano roll" Click="ShowTakeClicked" IsEnabled="False" />
                                <Button x:Name="CopyOpeningTimingButton" Content="Copy opening timing"
                                        Click="CopyOpeningTimingClicked" Visibility="Collapsed"
                                        ToolTipService.ToolTip="Copy MIDI receipt times and quantized targets for the count-in and first two bars." />
                                <TextBlock x:Name="TakeStatusText" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="PlacementResultPanel" Spacing="4" Visibility="Collapsed">
                                <TextBlock x:Name="PlacementLatencyText" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="PlacementLatencyDetailText" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlacementTimingText" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlacementOffsetText" TextWrapping="Wrap" />
                                <Button x:Name="PlacementOffsetButton" Content="Apply suggested offset"
                                        Click="ApplyPlacementOffsetClicked" HorizontalAlignment="Left" Visibility="Collapsed" />
                                <HyperlinkButton x:Name="PlacementCalibrationLink" Content="Open guided tap test…"
                                                 Click="ShowOffsetCalibrationClicked" Padding="0,2" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Note" />
                                <TextBlock Text="Beat" Grid.Column="1" />
                                <TextBlock Text="On input (ms)" Grid.Column="2"
                                           ToolTipService.ToolTip="Timing relative to the listed beat. Negative is early and positive is late." />
                                <TextBlock Text="After offset (ms)" Grid.Column="3"
                                           ToolTipService.ToolTip="Beat timing after recording compensation and before grid snapping." />
                                <TextBlock Text="Start tick" Grid.Column="4" />
                                <TextBlock Text="Length (ms)" Grid.Column="5" />
                            </Grid>
                            <ListView x:Name="TakeList" SelectionMode="None" MinHeight="72" MaxHeight="188"
                                      AutomationProperties.Name="Recorded notes, newest first">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TakeRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.25*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Pitch}" />
                                            <TextBlock Text="{x:Bind Beat}" Grid.Column="1" />
                                            <TextBlock Text="{x:Bind Raw}" Grid.Column="2" />
                                            <TextBlock Text="{x:Bind Adjusted}" Grid.Column="3" />
                                            <TextBlock Text="{x:Bind Tick}" Grid.Column="4" />
                                            <TextBlock Text="{x:Bind Length}" Grid.Column="5" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
