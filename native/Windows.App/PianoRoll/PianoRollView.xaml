<UserControl
    x:Class="Signal.Native.Windows.App.PianoRoll.PianoRollView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    AutomationProperties.Name="Piano roll"
    PreviewKeyDown="EditorKeyDown">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddButton" Click="AddClicked" ToolTipService.ToolTip="Add note (Insert)"
                        AutomationProperties.Name="Add note">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Add note" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Click="DeleteClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Delete selected notes (Delete)" AutomationProperties.Name="Delete notes">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Button x:Name="CutButton" Content="Cut" Click="CutClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Cut selected notes (Ctrl+X)" />
                <Button x:Name="CopyButton" Content="Copy" Click="CopyClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Copy selected notes (Ctrl+C)" />
                <Button x:Name="PasteButton" Content="Paste" Click="PasteClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Paste at the edit position (Ctrl+V). Shift-click an empty cell to set it." />
                <Button x:Name="UndoButton" Click="UndoClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Undo last edit (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Undo" />
                        <TextBlock Text="Undo" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="NoteCountText" Grid.Column="2" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Text="0 notes" />
        </Grid>

        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PitchColumn" Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TempoHeader" BorderThickness="0,0,1,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <TextBlock Text="Tempo" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <Grid x:Name="TempoInput" Grid.Column="1" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      AutomationProperties.Name="Song tempo lane"
                      ToolTipService.ToolTip="Click to add or edit a tempo. Drag a marker to move it."
                      PointerPressed="TempoPointerPressed" PointerMoved="TempoPointerMoved"
                      PointerReleased="TempoPointerReleased" PointerCaptureLost="TempoPointerCanceled"
                      PointerCanceled="TempoPointerCanceled">
                    <Canvas x:Name="TempoCanvas" IsHitTestVisible="False" />
                </Grid>
                <Border x:Name="Corner" Grid.Row="1" BorderThickness="0,0,1,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <TextBlock x:Name="PitchHeader" Text="Pitch" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <Grid x:Name="RulerInput" Grid.Row="1" Grid.Column="1"
                      AutomationProperties.Name="Loop range ruler"
                      ToolTipService.ToolTip="Click to move the playhead. Drag to set a loop. Left/Right step by beat. Shift+Left/Right step by bar."
                      PointerPressed="RulerPointerPressed" PointerMoved="RulerPointerMoved"
                      PointerReleased="RulerPointerReleased" PointerCaptureLost="RulerPointerCanceled"
                      PointerCanceled="RulerPointerCanceled">
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="RulerLoopFill" Height="29" Visibility="Collapsed" />
                        <Rectangle x:Name="RulerLoopStart" Canvas.Top="22" Height="7" Visibility="Collapsed" />
                        <Rectangle x:Name="RulerLoopEnd" Canvas.Top="22" Height="7" Visibility="Collapsed" />
                    </Canvas>
                    <Grid x:Name="TimelineViewport" IsHitTestVisible="False">
                        <Canvas x:Name="Timeline" />
                        <Canvas x:Name="RulerCursorLayer" />
                    </Grid>
                </Grid>
                <Canvas x:Name="PitchKeys" Grid.Row="2" IsHitTestVisible="False" />
                <ScrollViewer x:Name="EditorScroll" Grid.Row="2" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                              ZoomMode="Disabled" IsTabStop="False" BringIntoViewOnFocusChange="False"
                              ViewChanged="EditorViewChanged" SizeChanged="EditorSizeChanged">
                    <Grid x:Name="Surface" SizeChanged="EditorSizeChanged" PointerPressed="SurfacePointerPressed"
                          PointerMoved="SurfacePointerMoved" PointerReleased="SurfacePointerReleased"
                          PointerCaptureLost="SurfacePointerCanceled" PointerCanceled="SurfacePointerCanceled"
                          PointerExited="SurfacePointerExited">
                        <Canvas x:Name="GridLayer" IsHitTestVisible="False" />
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="GridLoopShade" Visibility="Collapsed" />
                        </Canvas>
                        <canvas:CanvasVirtualControl x:Name="ScoreDrawing" IsHitTestVisible="False"
                                                     RegionsInvalidated="DrawScore" />
                        <Canvas x:Name="RecordedLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="HeldLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="TransportLayer" IsHitTestVisible="False">
                            <Rectangle x:Name="Cursor" Width="2" Visibility="Collapsed" />
                            <Rectangle x:Name="SelectionBox" StrokeThickness="1" Opacity="0.3" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Drag empty space or Ctrl-click notes to select. Arrows nudge selected notes. Shift-click an empty cell to set the paste position."
                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <TextBlock Text="Grid" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                <ComboBox x:Name="GridSizeBox" SelectedIndex="2" SelectionChanged="GridSizeChanged"
                          AutomationProperties.Name="Piano-roll edit grid"
                          ToolTipService.ToolTip="Set the grid for adding, moving, resizing, and nudging notes">
                    <ComboBoxItem Content="1/4" />
                    <ComboBoxItem Content="1/8" />
                    <ComboBoxItem Content="1/16" />
                    <ComboBoxItem Content="1/32" />
                    <ComboBoxItem Content="1/64" />
                </ComboBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
