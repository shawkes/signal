<Window
    x:Class="Signal.Native.Windows.App.MidiMonitor.MidiMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Signal · MIDI monitor">
    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InputText" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="ActiveSensingBox" Content="Show Active Sensing" MinWidth="0"
                          Click="ActiveSensingClicked" />
                <ToggleButton x:Name="PauseButton" Content="Pause" Click="PauseClicked" />
                <Button Content="Clear" Click="ClearClicked" />
            </StackPanel>
        </Grid>
        <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None"
                  AutomationProperties.Name="Incoming MIDI messages, newest first">
            <ListView.Header>
                <TextBlock Text="Elapsed (ms)   Ch     Bytes      Message" FontFamily="Consolas" Margin="12,6" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Window>
